# ==============================================================================
# Production Environment Configuration Template
# ==============================================================================
# Ensure this file is copied to backend/.env or /etc/timetable/backend.env
# with strict permissions (chmod 600)

# 1. Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=prefer
DATABASE_URL="postgresql://timetable_user:SECURE_DB_PASSWORD@localhost:5432/timetable_db?schema=public"

# 2. Production Security Secret
# Must be at least 32 cryptographically random characters:
# Generate with: openssl rand -base64 36
JWT_SECRET="CHANGE_ME_TO_A_32_CHAR_OR_LONGER_CRYPTOGRAPHICALLY_SECURE_SECRET"
JWT_EXPIRES_IN="8h"

# 3. Application Ports and URLs
PORT=5000
NODE_ENV="production"
FRONTEND_URL="https://timetable.your-domain.edu"

# 4. Bootstrap Administrator Account (Initial seed only)
# Used during the first 'npm run prisma:seed' execution
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="REPLACE_WITH_A_STRONG_UNIQUE_ADMIN_PASSWORD"
CR_INITIAL_USERNAME="cr1"
CR_INITIAL_PASSWORD="REPLACE_WITH_A_STRONG_INITIAL_CR_PASSWORD"

# 5. Official Data Synchronization
GRIET_FACULTY_SOURCE_URL="https://www.griet.ac.in/images/Staff%20List%20for%20Website.pdf"
