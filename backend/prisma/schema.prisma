generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  HOD
  FACULTY
  CR
}

model Faculty {
  id               Int                 @id @default(autoincrement())
  name             String
  staffId          String              @unique
  department       String?
  designation      String?
  qualification    String?
  email            String?
  imageData        Bytes?
  imageMimeType    String?
  imageSourceUrl   String?
  profileSourceUrl String?
  lastScrapedAt    DateTime?
  imageHash        String?
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  timetableSlots   TimetableSlot[]     @relation("SlotFacultyA")
  batchBSlots      TimetableSlot[]     @relation("SlotFacultyB")
  overrides        TimetableOverride[] @relation("OverrideFacultyA")
  batchBOverrides  TimetableOverride[] @relation("OverrideFacultyB")
  draftSlots       TimetableDraftSlot[] @relation("DraftSlotFacultyA")
  batchBDraftSlots TimetableDraftSlot[] @relation("DraftSlotFacultyB")
  users            User[]

  @@index([name])
}

model Period {
  id              Int                  @id @default(autoincrement())
  periodNumber    Int?
  name            String               @db.VarChar(50)
  startTime       String               @db.Char(5)
  endTime         String               @db.Char(5)
  isBreak         Boolean              @default(false)
  order           Int                  @default(0)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  startSlots      TimetableSlot[]      @relation("SlotStartPeriod")
  endSlots        TimetableSlot[]      @relation("SlotEndPeriod")
  startDraftSlots TimetableDraftSlot[] @relation("DraftSlotStartPeriod")
  endDraftSlots   TimetableDraftSlot[] @relation("DraftSlotEndPeriod")

  @@index([order])
}

model FacultySyncRun {
  id         Int       @id @default(autoincrement())
  status     String
  sourceUrl  String
  created    Int       @default(0)
  updated    Int       @default(0)
  unchanged  Int       @default(0)
  failed     Int       @default(0)
  skipped    Int       @default(0)
  error      String?
  issues     Json?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([startedAt])
}

model Subject {
  id             Int                 @id @default(autoincrement())
  code           String              @unique @db.VarChar(50)
  name           String              @db.VarChar(120)
  isBreak        Boolean             @default(false)
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  timetableSlots TimetableSlot[]
  overrides      TimetableOverride[]
  draftSlots     TimetableDraftSlot[]
}

model ClassRoom {
  id            Int                 @id @default(autoincrement())
  year          Int
  branch        String
  section       String
  academicYear  String              @default("2026-27")
  semester      String?
  effectiveFrom String?
  metadata      Json?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  slots         TimetableSlot[]
  overrides     TimetableOverride[]
  drafts        TimetableDraft[]
  users         User[]

  @@unique([year, branch, section, academicYear])
}

model TimetableSlot {
  id              Int        @id @default(autoincrement())
  classId         Int
  day             Int
  startTime       String     @db.Char(5)
  endTime         String     @db.Char(5)
  startPeriodId   Int?
  endPeriodId     Int?
  room            String?    @db.VarChar(50)
  subjectId       Int?
  facultyId       Int?
  batchBFacultyId Int?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  class           ClassRoom  @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject         Subject?   @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  faculty         Faculty?   @relation("SlotFacultyA", fields: [facultyId], references: [id], onDelete: Restrict)
  batchBFaculty   Faculty?   @relation("SlotFacultyB", fields: [batchBFacultyId], references: [id], onDelete: Restrict)
  startPeriod     Period?    @relation("SlotStartPeriod", fields: [startPeriodId], references: [id], onDelete: SetNull)
  endPeriod       Period?    @relation("SlotEndPeriod", fields: [endPeriodId], references: [id], onDelete: SetNull)

  @@index([classId, day])
  @@unique([classId, day, startTime])
}

model TimetableOverride {
  id              Int        @id @default(autoincrement())
  classId         Int
  date            DateTime   @db.Date
  startTime       String     @db.Char(5)
  endTime         String     @db.Char(5)
  room            String?    @db.VarChar(50)
  subjectId       Int?
  facultyId       Int?
  batchBFacultyId Int?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  class           ClassRoom  @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject         Subject?   @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  faculty         Faculty?   @relation("OverrideFacultyA", fields: [facultyId], references: [id], onDelete: Restrict)
  batchBFaculty   Faculty?   @relation("OverrideFacultyB", fields: [batchBFacultyId], references: [id], onDelete: Restrict)

  @@index([classId, date])
}

model User {
  id            Int                  @id @default(autoincrement())
  username      String               @unique
  passwordHash  String
  role          UserRole
  isActive      Boolean              @default(true)
  classId       Int?
  facultyId     Int?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  class         ClassRoom?           @relation(fields: [classId], references: [id], onDelete: SetNull)
  faculty       Faculty?             @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  createdDrafts TimetableDraft[]

  @@index([role, classId])
  @@index([facultyId])
}

model TimetableDraft {
  id          Int                  @id @default(autoincrement())
  classId     Int
  name        String?              @db.VarChar(120)
  version     Int                  @default(1)
  status      String               @default("OPEN") @db.VarChar(20) // OPEN | PUBLISHED | DISCARDED
  createdById Int?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  class       ClassRoom            @relation(fields: [classId], references: [id], onDelete: Restrict)
  createdBy   User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  slots       TimetableDraftSlot[]

  @@index([classId])
  @@index([status])
}

model TimetableDraftSlot {
  id              Int            @id @default(autoincrement())
  draftId         Int
  day             Int
  startTime       String         @db.Char(5)
  endTime         String         @db.Char(5)
  startPeriodId   Int?
  endPeriodId     Int?
  room            String?        @db.VarChar(50)
  subjectId       Int?
  facultyId       Int?
  batchBFacultyId Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  draft           TimetableDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  subject         Subject?       @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  faculty         Faculty?       @relation("DraftSlotFacultyA", fields: [facultyId], references: [id], onDelete: Restrict)
  batchBFaculty   Faculty?       @relation("DraftSlotFacultyB", fields: [batchBFacultyId], references: [id], onDelete: Restrict)
  startPeriod     Period?        @relation("DraftSlotStartPeriod", fields: [startPeriodId], references: [id], onDelete: SetNull)
  endPeriod       Period?        @relation("DraftSlotEndPeriod", fields: [endPeriodId], references: [id], onDelete: SetNull)

  @@unique([draftId, day, startTime])
  @@index([draftId, day])
}

model TimetableLog {
  id          Int      @id @default(autoincrement())
  action      String   @db.VarChar(100)
  performedBy String   @db.VarChar(100)
  year        Int?
  branch      String?  @db.VarChar(50)
  section     String?  @db.VarChar(50)
  day         String?  @db.VarChar(50)
  date        String?  @db.VarChar(50)
  details     String?  @db.Text
  timestamp   DateTime @default(now())

  @@index([timestamp(sort: Desc)])
}
